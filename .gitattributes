# Auto-detect text files and normalize line endings to CRLF
* text=auto eol=crlf

# Code and text files
*.js text eol=crlf
*.jsx text eol=crlf
*.mjs text eol=crlf
*.cjs text eol=crlf
*.json text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.md text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.nsh text eol=crlf
*.sh text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.ini text eol=crlf

# Binary files - preserve exact byte contents without modifying line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.webp binary
*.zip binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.asar binary
